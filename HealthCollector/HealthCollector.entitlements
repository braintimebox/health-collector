<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The only two capabilities this app asks for. Anything else in this file
	     becomes an entitlement the signing profile must also carry, and a mismatch
	     is an install that fails for a reason nobody can read from the code.
	     The unsigned CI build embeds no entitlements at all: this file is applied
	     at the signing step, so it is also the artifact a reviewer compares the
	     profile against. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.background-delivery</key>
	<true/>
</dict>
</plist>
